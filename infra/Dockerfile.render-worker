# AICLIPER Video Render Worker (Cloud Run Jobs)
FROM node:22-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-dejavu-core \
    fonts-liberation \
    fonts-noto-core \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production

ENTRYPOINT ["node", "workers/renderWorker.ts"]
