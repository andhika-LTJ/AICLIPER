# AICLIPER Fase 0C — Minimal Standalone Video Render Worker Image (Cloud Run Jobs)
# Lockfile-safe install (repository uses bun.lock without package-lock.json) and strips frontend assets.
FROM node:22-slim

WORKDIR /workspace

# Install FFmpeg, FFprobe, and bundled TrueType fonts required for ASS subtitle & intro rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation \
    fonts-noto-core \
    ca-certificates \
    && fc-cache -f \
    && ffmpeg -version \
    && ffprobe -version \
    && rm -rf /var/lib/apt/lists/*

# Install production runtime dependencies only (lockfile-safe: works with or without package-lock.json)
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund \
    && npm cache clean --force

# Copy ONLY worker, backend, database schema, and shared type/utility modules (exclude React UI & public assets)
COPY workers ./workers
COPY server ./server
COPY src/db ./src/db
COPY src/types ./src/types
COPY src/utils ./src/utils
COPY src/data ./src/data
COPY tsconfig.json ./

# Prepare writable ephemeral working directories owned by non-root `node` user
RUN mkdir -p /workspace/data/tmp /workspace/data/renders /workspace/data/uploads \
    && chown -R node:node /workspace/data

ENV NODE_ENV=production
ENV GCS_REQUIRED=true
ENV WORKER_LOCK_TTL_SECONDS=2100

STOPSIGNAL SIGTERM

USER node

ENTRYPOINT ["node", "workers/renderWorker.ts"]
