# AICLIPER Fase 0C — Backend API & Frontend Static Server (Cloud Run Service)
# Lockfile-safe install (repository uses bun.lock without package-lock.json).
FROM node:22-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    && ffmpeg -version \
    && ffprobe -version \
    && rm -rf /var/lib/apt/lists/*

COPY package.json ./
RUN npm install --no-audit --no-fund \
    && npm cache clean --force

COPY . .
RUN npm run build \
    && npm prune --omit=dev \
    && mkdir -p /workspace/data/tmp /workspace/data/renders /workspace/data/uploads \
    && chown -R node:node /workspace/data

ENV NODE_ENV=production
ENV PORT=3000
ENV GCS_REQUIRED=true
ENV CLOUD_RENDER_DISPATCH_ENABLED=true

EXPOSE 3000
STOPSIGNAL SIGTERM

USER node

CMD ["node", "server.ts"]
