# AICLIPER Backend API & Frontend Static Server (Cloud Run Service)
FROM node:22-slim

WORKDIR /workspace

# Install lightweight runtime tools (no heavy Python CV bloat)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "server.ts"]
