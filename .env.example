# Wajib di server untuk fitur analisis & AI Content Studio (jangan pernah dibagikan ke frontend)
GEMINI_API_KEY=
PORT=3000

# Konfigurasi opsional (aktifkan sesuai kebutuhan produksi — lihat ENVIRONMENT.md untuk detail lengkap)
# NODE_ENV=production
# FIREBASE_PROJECT_ID=
# SUPER_ADMIN_EMAILS=yogandhika2132@gmail.com
# ADMIN_EMAILS=
# CORS_ALLOWED_ORIGINS=
# WEBHOOK_ALLOWED_DOMAINS=
# STREAM_TOKEN_SECRET=
# KLIPCAST_DB_PATH=data/klipcast.sqlite
#
# Google Cloud SQL PostgreSQL (pilih SQL_INSTANCE_CONNECTION_NAME / CLOUD_SQL_CONNECTION_NAME di Cloud Run atau SQL_HOST untuk TCP)
# SQL_INSTANCE_CONNECTION_NAME=project:region:instance
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
# SQL_HOST=127.0.0.1
# SQL_PORT=5432
# SQL_DB_NAME=aicliper
# CLOUD_SQL_DATABASE=aicliper
# SQL_USER=aicliper_app
# CLOUD_SQL_USER=aicliper_app
# SQL_PASSWORD=
# SQL_SSL=true
# PG_POOL_MAX=10
#
# Google Cloud Storage (wajib di NODE_ENV=production; fallback lokal hanya untuk dev/test)
# GCS_REQUIRED=true
# GCS_BUCKET_NAME=
# GCS_SIGNED_URL_TTL_SECONDS=3600
#
# Google Cloud Tasks + Authenticated OIDC Dispatcher + Cloud Run Jobs (Google ADC, TANPA static access token)
# CLOUD_RENDER_DISPATCH_ENABLED=true
# GCP_PROJECT_ID=
# GCP_REGION=asia-southeast2
# CLOUD_RUN_SERVICE_NAME=aicliper-api
# CLOUD_TASKS_LOCATION=asia-southeast2
# CLOUD_TASKS_MEDIA_QUEUE=media-ingestion
# CLOUD_TASKS_AI_QUEUE=ai-analysis-queue
# CLOUD_TASKS_RENDER_QUEUE=video-render-queue
# CLOUD_TASKS_PUBLISH_QUEUE=publish-queue
# WORKER_DISPATCH_BASE_URL=https://your-api-service.run.app
# CLOUD_TASKS_OIDC_SA_EMAIL=aicliper-tasks-invoker-sa@your-project.iam.gserviceaccount.com
# CLOUD_TASKS_OIDC_AUDIENCE=https://your-api-service.run.app
# CLOUD_RUN_RENDER_JOB_NAME=aicliper-render-worker
# CLOUD_RUN_JOB_NAME=aicliper-render-worker
# WORKER_LOCK_TTL_SECONDS=2100
#
# MAX_UPLOAD_MB=250
# MAX_CONCURRENT_UPLOADS=2
# MAX_CONCURRENT_RENDERS=2
# RENDER_JOB_TIMEOUT_MS=600000
# VITE_ASSET_CDN_BASE_URL=
# ASSET_CDN_BASE_URL=
# EXCLUDE_LOCAL_CDN_ASSETS=false

